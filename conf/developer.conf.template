# Developer-specific BitBake configuration
# Copy this to conf/developer.conf and customize
# Then include in your build: echo 'require ../../../developer.conf' >> build/conf/local.conf
#
# This file can be shared with team members to replicate build configurations

# =============================================================================
# ADU Delta Test Package - Import Manifest Customization
# =============================================================================
# These settings control the import manifests generated by adu-delta-test-package

# Update ID (appears in Azure IoT Hub Device Update service)
ADU_IMPORTMANIFEST_PROVIDER = "contoso"
ADU_IMPORTMANIFEST_NAME = "adu-yocto-rpi4-poc-1"

# Device compatibility matching (must match ADU agent configuration on device)
ADU_IMPORTMANIFEST_MANUFACTURER = "contoso"
ADU_IMPORTMANIFEST_MODEL = "adu-yocto-rpi4-poc-1"

# =============================================================================
# Build Performance Tuning
# =============================================================================
# Uncomment and adjust based on your build machine capabilities

# BB_NUMBER_THREADS = "8"        # BitBake parallel task execution
# PARALLEL_MAKE = "-j 8"         # Make parallel compilation jobs

# =============================================================================
# Shared State Cache (SSTATE)
# =============================================================================
# Speed up builds by sharing compiled artifacts
# Uncomment to use a shared sstate cache across team/builds

# SSTATE_DIR = "/shared/yocto/sstate-cache"

# =============================================================================
# Download Cache (DL_DIR)
# =============================================================================
# Share downloaded source tarballs across builds
# Uncomment to use a shared download directory

# DL_DIR = "/shared/yocto/downloads"

# =============================================================================
# Delta Update Feature Control
# =============================================================================
# Enable/disable delta update support (default: enabled)

# WITH_FEATURE_DELTA_UPDATE = "1"

# =============================================================================
# Example: Personal Developer Configuration
# =============================================================================
# Example for developer "alice" with custom settings:
#
# ADU_IMPORTMANIFEST_PROVIDER = "mycompany"
# ADU_IMPORTMANIFEST_NAME = "alice-dev-build"
# ADU_IMPORTMANIFEST_MANUFACTURER = "mycompany"
# ADU_IMPORTMANIFEST_MODEL = "rpi4-dev"
# BB_NUMBER_THREADS = "12"
# PARALLEL_MAKE = "-j 12"
# SSTATE_DIR = "/mnt/fast-ssd/sstate-cache"

# =============================================================================
# Example: Production Build Configuration
# =============================================================================
# Example for production builds:
#
# ADU_IMPORTMANIFEST_PROVIDER = "mycompany"
# ADU_IMPORTMANIFEST_NAME = "iot-device-prod"
# ADU_IMPORTMANIFEST_MANUFACTURER = "mycompany"
# ADU_IMPORTMANIFEST_MODEL = "iot-device-v1"
# SSTATE_DIR = "/build-server/sstate-cache"
# DL_DIR = "/build-server/downloads"
